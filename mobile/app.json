{
  "expo": {
    "name": "Kiwi",
    "slug": "kiwi",
    "scheme": "kiwi",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.kiwi.mobile"
    },
    "android": {
      "package": "dev.kiwi.mobile"
    },
    "plugins": [
      "expo-router",
      "react-native-quick-crypto",
      "expo-build-properties",
      "expo-sqlite",
      "expo-secure-store",
      "expo-image",
      ["expo-camera", { "cameraPermission": "Kiwi uses the camera to scan the code that links this phone to your desktop." }],
      ["expo-local-authentication", { "faceIDPermission": "Kiwi asks for Face ID before it opens the keys on this phone." }]
    ]
  }
}
