{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@mc/*": [
        "../src/*"
      ],
      "@web/*": [
        "../web/src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "jest",
      "node"
    ]
  }
}
