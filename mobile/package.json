{
  "name": "kiwi-mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "export": "expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "oxlint app src",
    "format": "oxfmt app src",
    "format:check": "oxfmt --check app src"
  },
  "dependencies": {
    "@ungap/structured-clone": "^1.4.0",
    "effect": "4.0.5",
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-crypto": "^1.1.8",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "26",
    "@types/react": "~19.3.0",
    "@types/ungap__structured-clone": "^1.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.11",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^\\./deflate\\.ts$": "<rootDir>/src/platform/deflate.ts",
      "^@mc/(.*)$": "<rootDir>/../src/$1"
    },
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|effect)"
    ]
  }
}
