node_modules/
dist/
.wrangler/
.relay-data/
*.bun-build
temp/
__pycache__/

.dev.vars
.dev.vars.*
.env
.env.*
*.sqlite
*.sqlite-wal
*.sqlite-shm
!.env.example

# Claude Code's per-session worktrees: whole checkouts of this repo
.claude/worktrees/

# iPhone app (ios/): Xcode's per-user state and the dev channel's throwaway folder
ios/**/xcuserdata/
.ios-dev/

# Electrobun shell (desktop/: bun run build:eb): its build, artifacts and the devkit Hutch projects
desktop/release-eb/
desktop/.hutch/

# Electrobun dev runs leave this behind
desktop/.cottontail-tmp/

# scripts/ui-dev-channel.ts: the local signing key
desktop/.ui-dev/

# scripts/ui-doc-fuzz.ts: its trace, written where it runs
doc-fuzz-*.txt

# scripts/docs-site.ts: the docs pages, built from docs/, and the app in demo mode, built from ui/
site/docs/
site/pt-br/
site/ja/
site/ko/
site/zh-cn/
site/demo/
site/afk/
