{
  "name": "kiwi",
  "version": "0.13.0",
  "description": "Real-time, end-to-end encrypted channels for coordinating AI agents across machines.",
  "type": "module",
  "private": true,
  "bin": {
    "kiwi": "src/cli/main.ts"
  },
  "scripts": {
    "kiwi": "bun src/cli/main.ts",
    "relay:dev": "wrangler dev",
    "relay:deploy": "wrangler deploy",
    "relay:local": "bun src/relay/bun.ts",
    "build": "bun build src/cli/main.ts --compile --external node-liblzma --external @mongodb-js/zstd --outfile dist/kiwi",
    "test": "bun test",
    "smoke:ui": "bun scripts/smoke-ui.ts",
    "ci:plan": "bun .github/jev-ci/cli.ts plan",
    "shots:ui": "bun scripts/shoot-ui.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && bun scripts/ui-tokens.ts && cd web && tsc -b && bun oxlint src && bun oxfmt --check src",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun install --frozen-lockfile && bun run build",
    "demo": "bun scripts/demo.ts",
    "changelog": "bun scripts/changelog.ts",
    "install:local": "scripts/install.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/bun": "^1.4.3",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "effect": "4.0.5",
    "just-bash": "3.6.0",
    "zod": "^4.6.7"
  }
}
