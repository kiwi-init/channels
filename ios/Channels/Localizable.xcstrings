    "Join" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参加"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참여"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入"
          }
        }
      }
    },
    "Join if your computer shows the same key. A different one means someone else answered." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピューターに同じ鍵が表示されていれば参加してください。鍵が違う場合は、別の誰かが応答しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터에 같은 키가 표시되면 참여하세요. 다른 키라면 다른 사람이 응답한 것입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre se seu computador mostrar a mesma chave. Uma diferente significa que outra pessoa respondeu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电脑显示的密钥相同才加入。密钥不同说明是别人在应答。"
          }
        }
      }
    },
    "Jump to the latest" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新へ移動"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신으로 이동"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir para as mais recentes"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳到最新"
          }
        }
      }
    },
    "Kept nothing. If your computer never showed %@, someone else answered this iPhone. Your computer may still list it under Devices: remove it there." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も残しませんでした。コンピューターに %@ が表示されなかった場合、この iPhone に応答したのは別の誰かです。コンピューターのデバイス一覧にこの iPhone がまだ表示されていれば、そこで削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 보관하지 않았습니다. 컴퓨터에 %@ 키가 표시된 적이 없다면 다른 사람이 이 iPhone에 응답한 것입니다. 컴퓨터의 기기 목록에 아직 남아 있을 수 있으니 거기서 제거하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi mantido. Se seu computador nunca mostrou %@, outra pessoa respondeu a este iPhone. Ele ainda pode aparecer em Dispositivos no seu computador: remova-o lá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未保留任何内容。如果你的电脑从未显示 %@，说明是别人回应了这部 iPhone。它可能仍出现在电脑的“设备”列表中：请在那里移除。"
          }
        }
      }
    },
