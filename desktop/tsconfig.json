{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "@types/bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "scripts/linux-files.ts", "scripts/package-linux.ts", "scripts/smoke-eb.ts", "scripts/eb-drive.ts", "scripts/eb-bridge-checks.ts", "scripts/eb-driver-check.ts"],
  "exclude": ["src/*-eb.ts"]
}
