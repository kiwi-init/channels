{
  "name": "kiwi-desktop",
  "version": "2026.10.15",
  "private": true,
  "description": "Channels desktop app: an Electrobun shell hosting ui/ for people (auto-approval, pairing, admin).",
  "homepage": "https://github.com/kiwi-init/channels",
  "author": {
    "name": "Jow",
    "email": "ojowwalker77@users.noreply.github.com"
  },
  "scripts": {
    "prepare:eb": "bun scripts/eb.ts prepare",
    "start:eb": "bun scripts/eb.ts dev",
    "build:eb": "bun scripts/eb.ts build --env=stable",
    "typecheck": "bunx tsrs --noEmit",
    "typecheck:eb": "bun run prepare:eb && bunx tsrs --noEmit -p tsconfig.eb.json"
  },
  "dependencies": {
    "@kiwi/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "electrobun": "2.0.5",
    "tsrs": "0.20.1-ts7.1.0-beta"
  }
}
