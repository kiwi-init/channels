{
  "name": "kiwi-desktop",
  "version": "0.13.0",
  "private": true,
  "description": "Kiwi desktop app: an Electron shell hosting web/ for people (auto-approval, pairing, admin).",
  "homepage": "https://github.com/ojowwalker77/channels",
  "author": {
    "name": "Jow",
    "email": "ojowwalker77@users.noreply.github.com"
  },
  "main": "dist/main.js",
  "desktopName": "kiwi-desktop.desktop",
  "scripts": {
    "build:main": "bun build src/main.ts --outfile dist/main.js --target node --format cjs --external electron",
    "build:preload": "bun build src/preload.ts --outfile dist/preload.js --target node --format cjs --external electron",
    "build:channels": "bun build src/channels.ts --outfile dist/channels.js --target node --format cjs --external electron",
    "build": "bun run build:main && bun run build:preload && bun run build:channels",
    "start": "bun run build && electron dist/main.js",
    "dist": "bun run build && electron-builder",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.kiwiinit.kiwi",
    "productName": "Kiwi",
    "files": [
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "protocols": {
      "name": "Kiwi",
      "schemes": [
        "kiwi"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "../dist/kiwi",
          "to": "kiwi"
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icons",
      "executableName": "kiwi-desktop",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "extraResources": [
        {
          "from": "../dist/kiwi",
          "to": "kiwi"
        }
      ]
    },
    "artifactName": "Kiwi-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    }
  }
}
