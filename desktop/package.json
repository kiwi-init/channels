{
  "name": "kiwi-desktop",
  "version": "2026.10.6",
  "private": true,
  "description": "Channels desktop app: an Electrobun shell hosting web/ for people (auto-approval, pairing, admin).",
  "homepage": "https://github.com/kiwi-init/channels",
  "author": {
    "name": "Jow",
    "email": "ojowwalker77@users.noreply.github.com"
  },
  "scripts": {
    "prepare:eb": "bun scripts/eb.ts prepare",
    "start:eb": "bun scripts/eb.ts dev",
    "build:eb": "bun scripts/eb.ts build --env=stable",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:eb": "bun run prepare:eb && bunx tsc --noEmit -p tsconfig.eb.json"
  },
  "dependencies": {
    "@kiwi/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "electrobun": "2.0.4",
    "typescript": "^7.0.2"
  }
}
