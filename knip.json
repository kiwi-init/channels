{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "gsettings",
    "xdg-user-dir",
    "weston-screenshooter",
    "iconutil",
    "clang",
    "cc",
    "sample",
    "pkg-config",
    "mksquashfs",
    "ditto",
    "hdiutil",
    "lsappinfo",
    "dbus-send",
    "gdbus",
    "pgrep",
    "xdotool",
    "swaymsg",
    "grim",
    "plutil",
    "secret-tool",
    "readelf"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "test/**/*.test.ts", "test/owner-cli.ts", "test/fixtures/home-probe.ts", "ios/engine/main.ts", "ios/scripts/*.ts", "android/scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "ios/**/*.ts", "android/**/*.ts"],
      "ignoreDependencies": ["cloudflare"],
      "ignoreUnresolved": ["src/cli/main.ts", "src/relay/bun.ts"]
    },
    "packages/core": {
      "includeEntryExports": true,
      "project": ["src/**/*.ts"]
    },
    "packages/app": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/channel": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/secrets": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "desktop": {
      "entry": ["src/main-eb.ts", "src/preload-eb.ts", "src/keys-worker.ts", "src/message-box-worker.ts", "src/search-worker.ts", "scripts/*.ts", "electrobun.config.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "ui": {
      "entry": ["src/chat/react-native.ts", "src/chat/no-elk.ts", "stubs/react-native/index.js", "src/**/*.test.{ts,tsx}"]
    }
  }
}
