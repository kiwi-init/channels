{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "channel-one",
  "main": "src/relay/worker.ts",
  "compatibility_date": "2026-10-01",
  // Channels by Kiwi Init lives at channels.kiwiinit.com; the workers.dev address keeps working
  // for clients that still use it.
  "routes": [{ "pattern": "channels.kiwiinit.com", "custom_domain": true }],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "CHANNELS", "class_name": "Channel" },
      { "name": "OWNERS", "class_name": "Owners" },
      { "name": "MAILBOX", "class_name": "MailboxBox" },
      { "name": "REPOS", "class_name": "Repos" },
      { "name": "MACHINES", "class_name": "MachineInbox" },
      { "name": "PERSON_MACHINES", "class_name": "PersonMachines" },
      { "name": "ACCOUNTS", "class_name": "Account" }
    ]
  },
  // SQLite-backed Durable Objects are the ones available on the Workers Free plan.
  // v2 deleted every pre-rename test room (deleting a class deletes all of its storage).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "deleted_classes": ["Room"] },
    { "tag": "v3", "new_sqlite_classes": ["Channel"] },
    { "tag": "v4", "new_sqlite_classes": ["Directory"] },
    { "tag": "v5", "new_sqlite_classes": ["MailboxBox"] },
    // 0.11: the signed-in channel lists are gone (their vaults, links and lists with them);
    // a small Owners object per person counts their owned channels for the create quota.
    { "tag": "v6", "deleted_classes": ["Directory"] },
    { "tag": "v7", "new_sqlite_classes": ["Owners"] },
    { "tag": "v8", "new_sqlite_classes": ["Repos"] },
    // New agent v2: one object per paired computer, holding its person, sealed asks and socket.
    { "tag": "v9", "new_sqlite_classes": ["MachineInbox"] },
    { "tag": "v10", "new_sqlite_classes": ["PersonMachines"] },
    // Linked devices: one object per signed-in person, holding their device list and enrollment ask.
    { "tag": "v11", "new_sqlite_classes": ["Account"] }
  ],
  // The public site (site/): landing page, invite links, install scripts.
  // Static assets are free and don't count as Worker requests.
  // SPA fallback so /join/<code> loads the page; API routes always reach the Worker.
  "assets": { "directory": "site", "not_found_handling": "single-page-application", "run_worker_first": ["/v1/*"] },
  // Humans sign in with WorkOS AuthKit (production environment). Public values: no secret lives on the relay.
  "vars": {
    "WORKOS_CLIENT_ID": "client_01M4ECYXMZT31ZKEEZ9X66ZBN8",
    // Moving sign-in to our own domain (#93): once WorkOS has verified it, list it first and keep
    // this one until the switch is done, e.g. "https://auth.kiwiinit.com,https://possible-pleasure-97.authkit.app".
    // docs/self-hosting.md#your-own-sign-in-domain has the steps.
    "WORKOS_AUTHKIT_DOMAIN": "https://possible-pleasure-97.authkit.app",
    // Private beta: only people on KIWI_BETA_USERS (WorkOS user ids, emails or "@domain",
    // comma-separated) create channels; anyone can still ask to join one. The list is a secret,
    // not a var, so it never lands in this public repo: `wrangler secret put KIWI_BETA_USERS`.
    // Where people who aren't on it can ask for access (empty: no link in the message).
    // No quotas on channels, members or messages, and channels never expire. Each channel keeps up
    // to 1 GB of ciphertext (SAFETY_BYTES_PER_CHANNEL), with the oldest messages making room.
    "KIWI_BETA_WAITLIST_URL": ""
  },
  // Rate limits per client address: 20 mailbox writes (launch asks and enrolments), 60 machine
  // registrations and inbox writes, 600 mailbox reads (pairings poll their slots about once a
  // second and concurrent ones share an address), 300 room reads and join asks on the join
  // flow's open paths (signed or not: a signature proves no membership), and 10 channel creates.
  // namespace_id must be unique in the Cloudflare account.
  "ratelimits": [
    { "name": "MAILBOX_WRITES", "namespace_id": "870202", "simple": { "limit": 20, "period": 60 } },
    { "name": "MACHINE_WRITES", "namespace_id": "870204", "simple": { "limit": 60, "period": 60 } },
    { "name": "MAILBOX_READS", "namespace_id": "870205", "simple": { "limit": 600, "period": 60 } },
    { "name": "ROOM_JOINS", "namespace_id": "870206", "simple": { "limit": 300, "period": 60 } },
    { "name": "ROOM_CREATES", "namespace_id": "870207", "simple": { "limit": 10, "period": 60 } }
  ],
  // No request logs: room ids and timing are nobody's business, and a closed
  // channel must leave nothing behind.
  "observability": { "enabled": false }
}
